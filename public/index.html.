*{box-sizing:border-box}body{margin:0;background:var(--bg);color:var(--ink);font:14px/1.45 Inter,system-ui,-apple-system,"Segoe UI",sans-serif}button,input,textarea,select{font:inherit}button{cursor:pointer;border:0;border-radius:9px;padding:9px 12px;background:#edf1f7;color:var(--ink);font-weight:650}button:hover{filter:brightness(.97)}button.primary{background:var(--blue);color:white}button.danger{background:var(--red);color:#fff}button.outline{background:white;border:1px solid var(--line)}button.active{background:#e6edff;color:var(--blue);box-shadow:inset 0 0 0 1px #b9c8ff}
.app{min-height:100vh;display:grid;grid-template-columns:210px minmax(0,1fr)}aside.sidebar{background:var(--navy);color:#dce5f5;padding:20px 13px;display:flex;flex-direction:column;gap:24px}.brand{display:flex;align-items:center;gap:9px;font-size:20px;font-weight:850;padding:0 7px}.logo{width:34px;height:34px;border-radius:11px;background:linear-gradient(135deg,#83a0ff,#4568e8);display:grid;place-items:center;color:white}.nav{display:grid;gap:6px}.nav button{background:transparent;color:#c4cee0;text-align:left;font-weight:550;display:flex;gap:10px;align-items:center}.nav button.selected,.nav button:hover{background:#263b5b;color:white}.sidefoot{margin-top:auto;color:#9eb0ca;font-size:11px;padding:8px}.main{min-width:0}.top{min-height:66px;background:white;border-bottom:1px solid var(--line);display:flex;align-items:center;justify-content:space-between;padding:10px 22px;gap:12px}.top strong{font-size:15px}.topactions{display:flex;gap:7px;align-items:center;flex-wrap:wrap}.topactions button{font-size:12px}.status{font-size:12px;color:var(--muted)}.dot{display:inline-block;width:8px;height:8px;background:#e0a72e;border-radius:50%;margin-right:5px}.dot.online{background:var(--green)}.layout{padding:16px;display:grid;grid-template-columns:minmax(0,1fr) 290px;gap:15px;max-width:1800px;margin:auto}.left,.right{display:grid;gap:14px;align-content:start;min-width:0}.card{background:white;border:1px solid var(--line);border-radius:14px;overflow:hidden;box-shadow:0 2px 8px #24365408}.head{padding:12px 15px;border-bottom:1px solid var(--line);display:flex;align-items:center;justify-content:space-between;gap:8px}.head h2{font-size:14px;margin:0}.small{font-size:11px;color:var(--muted)}.videos{background:#111a29;padding:9px;display:grid;grid-template-columns:1fr 1fr;gap:9px}.tile{background:linear-gradient(145deg,#2b3e5d,#172437);border-radius:10px;min-height:170px;position:relative;overflow:hidden;display:grid;place-items:center;color:#dce6f6}.tile video{width:100%;height:100%;position:absolute;inset:0;object-fit:cover}.placeholder{display:flex;flex-direction:column;align-items:center;gap:7px;text-align:center;padding:15px}.avatar{width:45px;height:45px;border-radius:50%;background:#415a81;display:grid;place-items:center;font-size:23px}.vname{position:absolute;left:9px;bottom:9px;background:#0b1220db;color:#fff;border-radius:7px;padding:4px 7px;font-size:11px;z-index:2}.vstatus{position:absolute;right:8px;top:8px;background:#0b1220bb;color:white;border-radius:20px;padding:4px 7px;font-size:10px;z-index:2}.controls{background:#111a29;display:flex;justify-content:center;gap:7px;padding:10px;flex-wrap:wrap}.controls button{background:#293850;color:white;font-size:12px}.controls button.on{background:#bd354a}.controls button.primary{background:var(--blue)}.boardtools{display:flex;gap:5px;flex-wrap:wrap}.boardtools button{padding:7px 9px;font-size:12px}.boardwrap{display:grid;grid-template-columns:44px minmax(0,1fr);min-height:420px}.toolbar{border-right:1px solid var(--line);padding:8px 5px;display:flex;flex-direction:column;align-items:center;gap:6px}.toolbar button{width:32px;height:32px;padding:0;display:grid;place-items:center}.toolbar input[type=color]{width:28px;height:28px;padding:0;border:0;background:none}.canvasarea{min-width:0;min-height:420px;background-image:radial-gradient(#e8edf6 1px,transparent 1px);background-size:20px 20px}.canvasarea canvas{display:block;width:100%;height:100%;min-height:420px;touch-action:none;cursor:crosshair}.boardfoot{display:flex;justify-content:space-between;align-items:center;gap:8px;flex-wrap:wrap;padding:9px 12px;border-top:1px solid var(--line)}.swatch{width:21px;height:21px;border-radius:50%;border:2px solid white;box-shadow:0 0 0 1px #d6dce7;padding:0}.swatch.chosen{box-shadow:0 0 0 2px var(--blue)}.lower{display:grid;grid-template-columns:1fr 1fr;gap:14px}.body{padding:13px 15px}.steps{display:grid;gap:9px}.step{display:flex;gap:8px;align-items:center}.step input{accent-color:var(--blue)}.mins{margin-left:auto;color:var(--muted);font-size:11px}.notes{width:100%;min-height:112px;resize:vertical;border:1px solid var(--line);border-radius:9px;padding:10px}.tabs{display:flex;gap:4px;padding:7px;border-bottom:1px solid var(--line)}.tabs button{flex:1;background:transparent;font-size:12px;padding:8px 4px;color:var(--muted)}.tabs button.active{background:#edf2ff;color:var(--blue)}.chatbody{height:245px;overflow:auto;padding:12px;display:flex;flex-direction:column;gap:11px}.msg{max-width:91%;align-self:flex-start}.msg.mine{align-self:flex-end}.meta{font-size:10px;color:var(--muted);margin-bottom:3px}.bubble{background:#f0f3f9;border-radius:4px 11px 11px 11px;padding:8px 10px;overflow-wrap:anywhere}.mine .bubble{background:#e5ecff;border-radius:11px 4px 11px 11px}.chatform{padding:9px;border-top:1px solid var(--line);display:flex;gap:6px}.chatform input{min-width:0;flex:1;border:1px solid var(--line);border-radius:8px;padding:9px}.hwlist{display:grid;gap:8px}.hwitem{border:1px solid var(--line);border-radius:9px;padding:10px}.hwitem label{display:flex;gap:8px}.hwitem input{margin-top:4px;accent-color:var(--blue)}.hwadd{display:flex;gap:6px;margin-top:10px}.hwadd input{min-width:0;flex:1;border:1px solid var(--line);border-radius:8px;padding:8px}.files{display:grid;gap:7px}.file{display:flex;align-items:center;gap:9px;padding:8px;border:1px solid var(--line);border-radius:9px}.fileicon{width:32px;height:35px;border-radius:7px;background:#fff0ef;color:#d94c4c;display:grid;place-items:center;font-weight:800;font-size:10px}.fileinfo{min-width:0;flex:1}.fileinfo strong{display:block;font-size:11px;overflow-wrap:anywhere}.fileinfo span{font-size:10px;color:var(--muted)}.file input{display:none}.notice{font-size:11px;line-height:1.5;color:#655b3d;background:#fff9e9;border:1px solid #f0e0b2;border-radius:10px;padding:10px}.hidden{display:none!important}.modalback{display:none;position:fixed;inset:0;background:#0b1426b5;z-index:20;place-items:center;padding:18px}.modalback.show{display:grid}.modal{width:min(680px,100%);max-height:90vh;overflow:auto;background:white;border-radius:15px;padding:20px;box-shadow:0 18px 80px #0003}.modal h2{margin:0 0 8px}.modal p{font-size:12px;color:var(--muted)}.modal textarea{width:100%;min-height:115px;border:1px solid var(--line);border-radius:9px;padding:10px;font:12px ui-monospace,monospace}.modalactions{display:flex;gap:7px;flex-wrap:wrap;margin-top:10px}.roomrow{display:flex;gap:8px;align-items:center;flex-wrap:wrap}.roomrow input{min-width:0;flex:1;border:1px solid var(--line);border-radius:9px;padding:9px}.pill{background:#edf2ff;color:var(--blue);padding:4px 8px;border-radius:20px;font-size:11px}
@media(max-width:1100px){.app{grid-template-columns:65px minmax(0,1fr)}aside.sidebar{padding:17px 7px}.brand{justify-content:center;padding:0}.brandname,.navlabel,.sidefoot{display:none}.nav button{justify-content:center;padding:12px 4px;font-size:17px}.layout{grid-template-columns:minmax(0,1fr) 260px;padding:11px;gap:11px}.top{padding:10px 13px}}
@media(max-width:780px){.app{display:block}aside.sidebar{display:none}.layout{display:flex;flex-direction:column;padding:9px}.top{align-items:flex-start;flex-direction:column}.videos{grid-template-columns:1fr 1fr}.tile{min-height:145px}.lower{grid-template-columns:1fr}.chatbody{height:190px}.boardwrap{min-height:340px}.canvasarea,.canvasarea canvas{min-height:340px}}
@media(max-width:460px){.videos{grid-template-columns:1fr}.tile{min-height:175px}.boardwrap{grid-template-columns:40px minmax(0,1fr)}.toolbar{padding:6px 3px}.toolbar button{width:30px;height:30px}}
</style>
</head>
<body>
<div class="app">
<aside class="sidebar"><div class="brand"><div class="logo">L</div><span class="brandname">LinguaRoom</span></div>
<nav class="nav"><button class="selected" data-scroll="lesson"><span>▣</span><span class="navlabel">Мой урок</span></button><button data-scroll="homework"><span>☑</span><span class="navlabel">Домашние задания</span></button><button data-scroll="materials"><span>▤</span><span class="navlabel">Материалы</span></button><button data-scroll="notes"><span>✎</span><span class="navlabel">Заметки</span></button></nav><div class="sidefoot">Класс преподавателя<br>LinguaRoom · beta</div></aside>
<main class="main"><header class="top"><div><strong>Английский язык</strong> <span class="status">· Индивидуальный урок</span><div class="status" style="margin-top:4px"><span id="serverDot" class="dot"></span><span id="serverStatus">Проверяем подключение…</span> · <span id="timer">00:00:00</span></div></div><div class="topactions"><button class="outline" id="roomBtn">↗ Пригласить ученика</button><button class="outline" id="uploadBtn">＋ Материалы</button><button class="danger" id="endBtn">Завершить урок</button></div></header>
<div class="layout"><section class="left" id="lesson">
<div class="card"><div class="videos">
<div class="tile"><video id="localVideo" autoplay playsinline muted class="hidden"></video><div class="placeholder" id="localPlaceholder"><div class="avatar">👨‍🏫</div><strong>Преподаватель</strong><span class="small">Включите камеру</span></div><span class="vname">Вы · Преподаватель</span><span class="vstatus" id="localStatus">Камера выключена</span></div>
<div class="tile"><video id="remoteVideo" autoplay playsinline class="hidden"></video><div class="placeholder" id="remotePlaceholder"><div class="avatar">👩‍🎓</div><strong>Ученик</strong><span class="small" id="remoteHint">Ожидаем подключения</span></div><span class="vname">Ученик</span><span class="vstatus" id="remoteStatus">Не подключён</span></div>
</div><div class="controls"><button id="micBtn">🎙 Микрофон</button><button id="camBtn">▣ Камера</button><button id="shareBtn">▱ Экран</button><button class="primary" id="connectBtn">Подключение</button></div></div>
<div class="card"><div class="head"><h2>Интерактивная доска</h2><div class="boardtools"><span class="small" id="boardStatus">Готова</span><button class="outline" id="clearBtn">Очистить</button><button class="outline" id="saveBoardBtn">Скачать PNG</button></div></div>
<div class="boardwrap"><div class="toolbar"><button class="active" data-tool="pen" title="Ручка">✎</button><button data-tool="eraser" title="Ластик">◩</button><button data-tool="line" title="Линия">／</button><button data-tool="rect" title="Прямоугольник">□</button><button data-tool="circle" title="Круг">○</button><button data-tool="text" title="Текст">T</button><input type="color" id="colorPicker" value="#2459d8" title="Цвет"><select id="sizePicker" aria-label="Толщина" style="width:35px;border:1px solid var(--line);border-radius:6px;font-size:10px;padding:3px"><option value="2">2</option><option value="4" selected>4</option><option value="7">7</option><option value="12">12</option></select></div><div class="canvasarea"><canvas id="board"></canvas></div></div>
<div class="boardfoot"><div style="display:flex;gap:7px;align-items:center"><span class="small">Цвет</span><button class="swatch chosen" data-color="#2459d8" style="background:#2459d8"></button><button class="swatch" data-color="#e74c65" style="background:#e74c65"></button><button class="swatch" data-color="#1b9b72" style="background:#1b9b72"></button><button class="swatch" data-color="#222b3a" style="background:#222b3a"></button><button class="swatch" data-color="#f0b429" style="background:#f0b429"></button></div><span class="small">Мышь · палец · стилус</span><div><button id="undoBtn">↶</button> <button id="redoBtn">↷</button></div></div></div>
<div class="lower"><div class="card"><div class="head"><h2>План урока</h2><span class="small">50 минут</span></div><div class="body steps"><label class="step"><input type="checkbox" checked> Warm-up <span class="mins">5 мин</span></label><label class="step"><input type="checkbox"> Grammar: Present Perfect <span class="mins">15 мин</span></label><label class="step"><input type="checkbox"> Speaking <span class="mins">15 мин</span></label><label class="step"><input type="checkbox"> Listening <span class="mins">10 мин</span></label><label class="step"><input type="checkbox"> Homework <span class="mins">5 мин</span></label></div></div>
<div class="card" id="notes"><div class="head"><h2>Заметки преподавателя</h2><span class="small">Автосохранение</span></div><div class="body"><textarea class="notes" id="notesInput" placeholder="Ошибки, новые слова, темы для повторения…"></textarea></div></div></div>
</section>
<aside class="right" style="background:transparent;color:inherit;padding:0">
<div class="card"><div class="tabs"><button class="active" data-tab="chat">Чат</button><button data-tab="people">Участники</button></div><div id="chatPanel"><div class="chatbody" id="chatBody"><div class="msg"><div class="meta">LinguaRoom</div><div class="bubble">Урок готов. Отправьте ученику ссылку-приглашение, чтобы подключить видео, чат и доску.</div></div></div><form class="chatform" id="chatForm"><input id="chatInput" placeholder="Сообщение…" autocomplete="off"><button class="primary">➤</button></form></div><div id="peoplePanel" class="body hidden"><p><b>Преподаватель</b><br><span class="small">Вы · текущий браузер</span></p><hr style="border:0;border-top:1px solid var(--line)"><p><b>Ученик</b><br><span class="small" id="participantStatus">Ожидает подключения</span></p><p class="small">Подключение по уникальной ссылке комнаты.</p></div></div>
<div class="card" id="homework"><div class="head"><h2>Домашние задания</h2><span class="small" id="hwCount">3 осталось</span></div><div class="body"><div class="hwlist" id="hwList"></div><form class="hwadd" id="hwForm"><input id="hwInput" maxlength="180" placeholder="Добавить задание…"><button class="primary">+</button></form></div></div>
<div class="card" id="materials"><div class="head"><h2>Материалы урока</h2><button class="outline" id="fileBtn">＋ Файл</button></div><div class="body"><div class="files" id="fileList"><div class="file"><div class="fileicon">TXT</div><div class="fileinfo"><strong>Present Perfect — worksheet</strong><span>Демонстрационный материал</span></div><button class="outline" data-demo="worksheet">Открыть</button></div><div class="file"><div class="fileicon" style="background:#eef4ff;color:#4568e8">TXT</div><div class="fileinfo"><strong>Vocabulary list</strong><span>Слова к уроку</span></div><button class="outline" data-demo="vocab">Открыть</button></div></div><input type="file" id="fileInput" multiple class="hidden"></div></div>
<div class="notice">Доска, чат, задания и заметки синхронизируются между участниками комнаты. Для камеры и микрофона нужен HTTPS. Прототип не хранит данные на сервере после закрытия комнаты; заметки и задания сохраняются локально в браузере.</div>
</aside></div></main></div>
<div class="modalback" id="roomModal"><div class="modal"><h2>Пригласить ученика</h2><p>Ссылка создаёт отдельную комнату. Отправьте её ученику; он откроет страницу и нажмёт «Подключиться к уроку». Сигнализация выполняется автоматически через сервер.</p><div class="roomrow"><input id="roomLink" readonly><button class="primary" id="copyLink">Копировать ссылку</button></div><p id="roomModalStatus">Код комнаты: <b id="roomCode"></b></p><div class="modalactions"><button class="outline" id="closeRoom">Закрыть</button></div></div></div>
<div class="modalback" id="genericModal"><div class="modal"><h2 id="genericTitle"></h2><div id="genericContent"></div><div class="modalactions"><button class="primary" id="genericClose">Закрыть</button></div></div></div>
<script src="/socket.io/socket.io.js"></script>
<script>
(()=>{'use strict';
const $=s=>document.querySelector(s),$$=s=>Array.from(document.querySelectorAll(s));
const save=(k,v)=>{try{localStorage.setItem('lr_'+k,JSON.stringify(v))}catch{}},load=(k,d)=>{try{let v=localStorage.getItem('lr_'+k);return v?JSON.parse(v):d}catch{return d}};
const params=new URLSearchParams(location.search);let room=params.get('room');if(!room){room=crypto.randomUUID().slice(0,8);params.set('room',room);history.replaceState({},'',location.pathname+'?'+params.toString())}
$('#roomCode').textContent=room.toUpperCase();$('#roomLink').value=location.origin+location.pathname+'?room='+encodeURIComponent(room)+'&student=1';
let role=params.get('role')||(params.has('student')?'student':'teacher'),socket=null,pc=null,stream=null,screenStream=null,dc=null,started=Date.now(),peerId=null,callStarted=false;
$('#timer').textContent='00:00:00';setInterval(()=>{let s=Math.floor((Date.now()-started)/1000);$('#timer').textContent=[Math.floor(s/3600),Math.floor(s%3600/60),s%60].map(n=>String(n).padStart(2,'0')).join(':')},1000);
function status(t,ok=false){$('#serverStatus').textContent=t;$('#serverDot').classList.toggle('online',ok)}
if(typeof io==='function'){socket=io();socket.on('connect',()=>{status('Сервер подключён',true);socket.emit('join-room',{room,role})});socket.on('connect_error',()=>status('Нет связи с сервером',false));socket.on('peer-joined',data=>{peerId=data.id;$('#remoteHint').textContent='Участник в комнате';$('#remoteStatus').textContent='Готов к звонку';$('#participantStatus').textContent='В комнате';if(role==='teacher'&&!callStarted)startCall().catch(e=>showError(e.message))});socket.on('peer-left',()=>{peerId=null;$('#remoteStatus').textContent='Участник отключился';$('#participantStatus').textContent='Отключён';if(remoteVideo.srcObject){remoteVideo.srcObject.getTracks().forEach(t=>t.stop());remoteVideo.srcObject=null}remoteVideo.classList.add('hidden');$('#remotePlaceholder').classList.remove('hidden')});socket.on('signal',async({from,data})=>{try{if(!pc)await createPeer();if(data.type==='offer'){await pc.setRemoteDescription(data);const answer=await pc.createAnswer();await pc.setLocalDescription(answer);socket.emit('signal',{room,to:from,data:pc.localDescription})}else if(data.type==='answer'){await pc.setRemoteDescription(data)}else if(data.candidate){try{await pc.addIceCandidate(data)}catch(e){console.warn(e)}}}catch(e){showError('Не удалось установить связь: '+e.message)}});socket.on('sync',m=>handleSync(m));socket.on('chat',m=>appendMessage(m.text,m.name||'Ученик',false));socket.on('homework',m=>renderHomework(m.items,false));socket.on('board-clear',()=>clearCanvas(false));socket.on('board-item',s=>{strokes.push(s);persistStrokes();renderBoard()});socket.on('notes-sync',m=>{if(document.activeElement!==$('#notesInput'))$('#notesInput').value=m.text})}else status('Запустите через сервер Node.js',false);
function showError(m){alert(m)}
async function ensureMedia(){if(!navigator.mediaDevices?.getUserMedia)throw Error('Камера доступна через HTTPS или localhost.');if(!stream){stream=await navigator.mediaDevices.getUserMedia({video:true,audio:true});$('#localVideo').srcObject=stream;$('#localVideo').classList.remove('hidden');$('#localPlaceholder').classList.add('hidden');$('#localStatus').textContent='Камера и микрофон готовы';if(pc)stream.getTracks().forEach(t=>pc.addTrack(t,stream))}return stream}
async function createPeer(){if(pc)pc.close();pc=new RTCPeerConnection({iceServers:[{urls:'stun:stun.l.google.com:19302'},{urls:'stun:stun1.l.google.com:19302'}]});if(stream)stream.getTracks().forEach(t=>pc.addTrack(t,stream));pc.ontrack=e=>{remoteVideo.srcObject=e.streams[0];remoteVideo.classList.remove('hidden');$('#remotePlaceholder').classList.add('hidden');$('#remoteStatus').textContent='Подключён';$('#participantStatus').textContent='Подключён'};pc.onicecandidate=e=>{if(e.candidate&&socket&&peerId)socket.emit('signal',{room,to:peerId,data:e.candidate})};pc.onconnectionstatechange=()=>{if(pc.connectionState==='connected'){$('#remoteStatus').textContent='Подключён';$('#connectBtn').textContent='✓ Ученик подключён'}else if(pc.connectionState==='failed')$('#remoteStatus').textContent='Ошибка связи'};return pc}
async function startCall(){if(callStarted||!socket||!peerId)return;callStarted=true;await ensureMedia();await createPeer();const offer=await pc.createOffer();await pc.setLocalDescription(offer);socket.emit('signal',{room,to:peerId,data:pc.localDescription})}
$('#connectBtn').onclick=async()=>{try{await ensureMedia();if(role==='student'){if(socket)socket.emit('ready',{room});$('#connectBtn').textContent='Ожидаем преподавателя…';if(peerId)await startCall()}else{if(!peerId){$('#roomModal').classList.add('show');return}await startCall()}}catch(e){showError(e.message)}};
$('#camBtn').onclick=async()=>{try{await ensureMedia();const t=stream.getVideoTracks()[0];t.enabled=!t.enabled;$('#camBtn').classList.toggle('on',!t.enabled);$('#localStatus').textContent=t.enabled?'Камера включена':'Камера выключена';$('#localVideo').classList.toggle('hidden',!t.enabled);$('#localPlaceholder').classList.toggle('hidden',t.enabled)}catch(e){showError(e.message)}};
$('#micBtn').onclick=async()=>{try{await ensureMedia();const t=stream.getAudioTracks()[0];t.enabled=!t.enabled;$('#micBtn').classList.toggle('on',!t.enabled);$('#micBtn').textContent=t.enabled?'🎙 Микрофон':'🔇 Микрофон выключен'}catch(e){showError(e.message)}};
$('#shareBtn').onclick=async()=>{try{screenStream=await navigator.mediaDevices.getDisplayMedia({video:true});const track=screenStream.getVideoTracks()[0];if(pc){const sender=pc.getSenders().find(s=>s.track&&s.track.kind==='video');if(sender)await sender.replaceTrack(track);else pc.addTrack(track,screenStream)}$('#localVideo').srcObject=screenStream;$('#localVideo').classList.remove('hidden');$('#localPlaceholder').classList.add('hidden');$('#shareBtn').classList.add('on');track.onended=()=>{if(stream)$('#localVideo').srcObject=stream;$('#shareBtn').classList.remove('on')}}catch(e){showError(e.message)}};
$('#roomBtn').onclick=()=>$('#roomModal').classList.add('show');$('#closeRoom').onclick=()=>$('#roomModal').classList.remove('show');$('#copyLink').onclick=async()=>{try{await navigator.clipboard.writeText($('#roomLink').value);$('#roomModalStatus').textContent='Ссылка скопирована. Отправьте её ученику.'}catch{$('#roomLink').select();document.execCommand('copy');$('#roomModalStatus').textContent='Скопируйте выделенную ссылку.'}};
$('#endBtn').onclick=()=>{if(confirm('Завершить урок?')){if(socket)socket.emit('leave-room',{room});if(pc)pc.close();if(stream)stream.getTracks().forEach(t=>t.stop());if(screenStream)screenStream.getTracks().forEach(t=>t.stop());$('#remoteStatus').textContent='Урок завершён';$('#localStatus').textContent='Камера выключена';status('Урок завершён',false)}};
function emitSync(data){if(socket&&socket.connected)socket.emit('sync',{room,data})}
const canvas=$('#board'),ctx=canvas.getContext('2d');let strokes=load('strokes',[]),redo=[],tool='pen',color='#2459d8',size=4,drawing=null;const W=1000,H=600;
function resize(){const r=canvas.getBoundingClientRect(),d=Math.min(devicePixelRatio||1,2);if(!r.width||!r.height)return;canvas.width=Math.round(r.width*d);canvas.height=Math.round(r.height*d);ctx.setTransform(canvas.width/W,0,0,canvas.height/H,0,0);renderBoard()}
function paint(s){if(!s||!s.points?.length)return;if(s.kind==='text'){ctx.fillStyle=s.color;ctx.font=`${s.size*5+10}px system-ui`;ctx.fillText(s.text,s.points[0].x,s.points[0].y);return}ctx.strokeStyle=s.kind==='eraser'?'#fff':s.color;ctx.lineWidth=s.kind==='eraser'?s.size*4:s.size;ctx.lineCap='round';ctx.lineJoin='round';let p=s.points;ctx.beginPath();ctx.moveTo(p[0].x,p[0].y);let end=p[p.length-1];if(s.kind==='rect')ctx.rect(p[0].x,p[0].y,end.x-p[0].x,end.y-p[0].y);else if(s.kind==='circle')ctx.ellipse((p[0].x+end.x)/2,(p[0].y+end.y)/2,Math.abs(end.x-p[0].x)/2,Math.abs(end.y-p[0].y)/2,0,0,Math.PI*2);else if(s.kind==='line')ctx.lineTo(end.x,end.y);else for(let i=1;i<p.length;i++)ctx.lineTo(p[i].x,p[i].y);ctx.stroke()}
function renderBoard(){ctx.clearRect(0,0,W,H);ctx.fillStyle='#fff';ctx.fillRect(0,0,W,H);strokes.forEach(paint);if(drawing)paint(drawing)}
function persistStrokes(){save('strokes',strokes)}
function clearCanvas(sync=true){strokes=[];redo=[];persistStrokes();renderBoard();if(sync&&socket)socket.emit('board-clear',{room})}
function pnt(e){let r=canvas.getBoundingClientRect();return{x:(e.clientX-r.left)/r.width*W,y:(e.clientY-r.top)/r.height*H}}
canvas.onpointerdown=e=>{canvas.setPointerCapture(e.pointerId);let p=pnt(e);if(tool==='text'){let t=prompt('Текст на доске');if(t){let s={kind:'text',color,size,points:[p],text:t};strokes.push(s);persistStrokes();renderBoard();if(socket)socket.emit('board-item',{room,item:s})}return}drawing={kind:tool,color,size,points:[p]};renderBoard()};
canvas.onpointermove=e=>{if(drawing){drawing.points.push(pnt(e));renderBoard()}};function finish(){if(drawing){strokes.push(drawing);if(socket)socket.emit('board-item',{room,item:drawing});drawing=null;redo=[];persistStrokes();renderBoard()}}canvas.onpointerup=finish;canvas.onpointercancel=finish;
if('ResizeObserver'in window)new ResizeObserver(resize).observe(canvas.parentElement);else window.addEventListener('resize',resize);setTimeout(resize,100);
$$('[data-tool]').forEach(b=>b.onclick=()=>{$$('[data-tool]').forEach(x=>x.classList.toggle('active',x===b));tool=b.dataset.tool});$('#colorPicker').oninput=e=>{color=e.target.value;$$('.swatch').forEach(b=>b.classList.toggle('chosen',b.dataset.color===color))};$$('.swatch').forEach(b=>b.onclick=()=>{color=b.dataset.color;$('#colorPicker').value=color;$$('.swatch').forEach(x=>x.classList.toggle('chosen',x===b))});$('#sizePicker').onchange=e=>size=+e.target.value;$('#clearBtn').onclick=()=>{if(confirm('Очистить доску?'))clearCanvas()};$('#undoBtn').onclick=()=>{if(strokes.length){redo.push(strokes.pop());persistStrokes();renderBoard();if(socket)socket.emit('sync',{room,data:{type:'board-state',items:strokes}})}};$('#redoBtn').onclick=()=>{if(redo.length){strokes.push(redo.pop());persistStrokes();renderBoard();if(socket)socket.emit('sync',{room,data:{type:'board-state',items:strokes}})}};$('#saveBoardBtn').onclick=()=>{let a=document.createElement('a');a.download='linguaroom-board.png';a.href=canvas.toDataURL('image/png');a.click()};
function appendMessage(text,name,mine){let d=document.createElement('div');d.className='msg'+(mine?' mine':'');let m=document.createElement('div');m.className='meta';m.textContent=name+' · '+new Date().toLocaleTimeString('ru-RU',{hour:'2-digit',minute:'2-digit'});let b=document.createElement('div');b.className='bubble';b.textContent=text;d.append(m,b);$('#chatBody').append(d);$('#chatBody').scrollTop=$('#chatBody').scrollHeight}
$('#chatForm').onsubmit=e=>{e.preventDefault();let text=$('#chatInput').value.trim();if(!text)return;appendMessage(text,'Вы',true);if(socket)socket.emit('chat',{room,text,name:role==='student'?'Ученик':'Преподаватель'});$('#chatInput').value=''};
$$('[data-tab]').forEach(b=>b.onclick=()=>{$$('[data-tab]').forEach(x=>x.classList.toggle('active',x===b));$('#chatPanel').classList.toggle('hidden',b.dataset.tab!=='chat');$('#peoplePanel').classList.toggle('hidden',b.dataset.tab!=='people')});
let homework=load('homework',[{text:'Complete the sentences (Present Perfect).',done:false},{text:'Write 5 sentences about your life.',done:false},{text:'Learn 10 new words from the lesson.',done:false}]);
function renderHomework(items,saveIt=true){homework=items;$('#hwList').replaceChildren();items.forEach((it,i)=>{let d=document.createElement('div');d.className='hwitem';let l=document.createElement('label'),c=document.createElement('input'),t=document.createElement('span');c.type='checkbox';c.checked=it.done;c.onchange=()=>{homework[i].done=c.checked;renderHomework(homework);if(socket)socket.emit('homework',{room,items:homework})};t.textContent=it.text;t.style.textDecoration=it.done?'line-through':'none';l.append(c,t);d.append(l);$('#hwList').append(d)});$('#hwCount').textContent=items.filter(x=>!x.done).length+' осталось';if(saveIt)save('homework',items)}
renderHomework(homework,false);$('#hwForm').onsubmit=e=>{e.preventDefault();let t=$('#hwInput').value.trim();if(!t)return;homework.push({text:t,done:false});renderHomework(homework);if(socket)socket.emit('homework',{room,items:homework});$('#hwInput').value=''};
$('#notesInput').value=load('notes','');$('#notesInput').oninput=()=>{save('notes',$('#notesInput').value);if(socket)socket.emit('notes-sync',{room,text:$('#notesInput').value})};
function handleSync(m){if(m?.type==='board-state'){strokes=m.items||[];persistStrokes();renderBoard()}}
$('#fileBtn').onclick=()=>$('#fileInput').click();$('#uploadBtn').onclick=()=>$('#fileInput').click();$('#fileInput').onchange=e=>{for(let f of e.target.files){let d=document.createElement('div');d.className='file';let i=document.createElement('div');i.className='fileicon';i.textContent=(f.name.split('.').pop()||'FILE').slice(0,4).toUpperCase();let inf=document.createElement('div');inf.className='fileinfo';let s=document.createElement('strong');s.textContent=f.name;let sm=document.createElement('span');sm.textContent=Math.round(f.size/1024)+' КБ · локальный файл';inf.append(s,sm);let b=document.createElement('button');b.className='outline';b.textContent='Открыть';b.onclick=()=>window.open(URL.createObjectURL(f),'_blank','noopener');d.append(i,inf,b);$('#fileList').append(d)}};
function generic(title,text){$('#genericTitle').textContent=title;let c=$('#genericContent');c.replaceChildren();let p=document.createElement('pre');p.style.whiteSpace='pre-wrap';p.style.font='inherit';p.textContent=text;c.append(p);$('#genericModal').classList.add('show')}
$('#genericClose').onclick=()=>$('#genericModal').classList.remove('show');$$('[data-demo]').forEach(b=>b.onclick=()=>generic(b.dataset.demo==='worksheet'?'Present Perfect — worksheet':'Vocabulary list',b.dataset.demo==='worksheet'?'1. I ___ (visit) London.\n2. She ___ already ___ (finish) her homework.\n3. We ___ (not / see) this film.\n4. Write three questions with “Have you ever…?”\n5. Write five sentences about your life.':'experience — опыт\nrecently — недавно\nalready — уже\never — когда-либо\nyet — ещё / уже\njust — только что\nsince — с (момента)\nfor — в течение\nimprove — улучшать\nachievement — достижение'));
$$('[data-scroll]').forEach(b=>b.onclick=()=>{$$('[data-scroll]').forEach(x=>x.classList.toggle('selected',x===b));let map={lesson:'#lesson',homework:'#homework',materials:'#materials',notes:'#notes'};$(map[b.dataset.scroll]).scrollIntoView({behavior:'smooth',block:'start'})});
if(role==='student'){$('strong').textContent='Английский язык';$('#connectBtn').textContent='Подключиться к уроку';$('#remoteHint').textContent='Подключение к преподавателю';}
})();
</script>
